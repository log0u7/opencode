        // Disabled in models.ini: 32768 training ctx, 11 t/s in service.
        // "qwen2.5-coder-14b": {
        //   "id": "qwen2.5-coder-14b",
        //   "name": "Qwen2.5-Coder 14B (dense, code-intensive)",
        //   "tool_call": true,
        //   "limit": { "context": 15000, "output": 4096 }
        // },
        // Disabled in models.ini: 47 tg vs 105 for qwen3.5-9b.
