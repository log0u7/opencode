{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills",
      "~/.config/opencode/skills/ui-ux-pro-max/.claude/skills",
      "~/.config/opencode/skills/impeccable/.opencode/skills"
    ]
  },
  "plugin": [
    "~/.config/opencode/plugins/caveman/plugin.js",
    "@slkiser/opencode-quota",
    "opencode-pty"
  ],
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 6000,
    "reserved": 2000
  },
  "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
  "small_model": "llamacpp-ricinus/qwen3.5-9b-mtp",
  "agent": {
    "build": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
      "temperature": 0.6,
      "top_p": 0.95,
      "steps": 60,
      "color": "info"
    },
    "plan": {
      "model": "opencode/big-pickle",
      "color": "warning"
    },
    "general": {
      "model": "opencode/big-pickle"
    },
    "explore": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
      "temperature": 0.6,
      "top_p": 0.95,
      "steps": 60
    },
    "title": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
    },
    "summary": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
    }//,
    //"compaction": {
    //  "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
    //}
  },
  "share": "disabled",
  "autoupdate": "notify",
  "formatter": true,
  "provider": {
    "llamacpp-ricinus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "00 llama.cpp@ricinus-communis",
      "options": {
        "baseURL": "http://192.168.1.26:9931/v1",
        "apiKey": "llamacpp",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        "glm-4.7-flash": {
          "id": "glm-4.7-flash",
          "name": "GLM-4.7-Flash 30B-A3B (think, coder)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 30000,
            "output": 12288
          }
        },
        "qwen3.5-9b": {
          "id": "qwen3.5-9b",
          "name": "Qwen3.5 9B (think, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-nt": {
          "id": "qwen3.5-9b-nt",
          "name": "Qwen3.5 9B (nothink, generalist)",
          "tool_call": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-mtp": {
          "id": "qwen3.5-9b-mtp",
          "name": "Qwen3.5 9B (think, mtp, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        }
      }
    },
    "ollama-ricinus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "01 ollama@ricinus-communis",
      "options": {
        "baseURL": "http://192.168.1.26:11434/v1",
        "apiKey": "ollama",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        "qwen3.5-9b": {
          "id": "qwen3.5-9b",
          "name": "Qwen3.5 9B (think, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-nt": {
          "id": "qwen3.5-9b-nt",
          "name": "Qwen3.5 9B (nothink, generalist)",
          "tool_call": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-mtp": {
          "id": "qwen3.5-9b-mtp",
          "name": "Qwen3.5 9B (think, mtp, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        }
      }
    }
  },
  "enabled_providers": ["llamacpp-ricinus", "ollama-ricinus", "opencode"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
