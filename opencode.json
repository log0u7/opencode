{
  "$schema": "https://opencode.ai/config.json",
  //"default_agent": "plan",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": [
    "~/.config/opencode/skills",
    "~/.config/opencode/skills/ui-ux-pro-max/.claude/skills",
    "~/.config/opencode/skills/impeccable/.opencode/skills"
  ],
  "plugins": [
    "./plugins/caveman",
    "@slkiser/opencode-quota",
    //"@log0u7/opencode-mesh",
    //"@log0u7/opencode-watt",
    "@log0u7/opencode-memory"
  ],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "pkill*", "effect": "deny" },
    { "action": "shell", "resource": "kill -9*", "effect": "deny" },
    { "action": "shell", "resource": "killall*", "effect": "deny" },
    { "action": "shell", "resource": "sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*;sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*; sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*&&sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*&& sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*||sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*|| sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*&sleep*", "effect": "deny" },
    { "action": "shell", "resource": "*& sleep*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "halt*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr ~/", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ..", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "dd if=*of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "dd of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "wipefs*", "effect": "deny" },
    { "action": "shell", "resource": "chmod -R 777 /", "effect": "deny" },
    { "action": "shell", "resource": "crontab -r*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fdx*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -fx*", "effect": "deny" },
    { "action": "shell", "resource": "history -c*", "effect": "deny" },
    { "action": "shell", "resource": ":(){ :|:& };:", "effect": "deny" },
    { "action": "shell", "resource": "proxychains4*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode", "effect": "allow" }
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 6000 },
    "buffer": "10%"
  },
  "model": "openrouter/z-ai/glm-5.3-flash",
  "agents": {
    "build": {
      "model": "openrouter/z-ai/glm-5.3-flash",
      "color": "#56b6c2"
    },
    "plan": {
      "model": "openrouter/z-ai/glm-5.3-flash",
      "color": "#f5a742"
    },
    "general": {
      "model": "openrouter/z-ai/glm-5.3-flash"
    },
    "explore": {
      "model": "openrouter/z-ai/glm-5.3-flash#explore",
      "steps": 60
    },
    "title": {
      "model": "openrouter/z-ai/glm-5.3-flash"
    }
  },
  "share": "disabled",
  "update": "notify",
  "formatter": true,
  "providers": {
    "llamacpp-ricinus": {
      "name": "00 llama.cpp@ricinus-communis",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.1.26:9931/v1",
        "apiKey": "llamacpp",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        "glm-4.7-flash": {
          "modelID": "glm-4.7-flash",
          "name": "GLM-4.7-Flash 30B-A3B (think, coder)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 30000,
            "output": 12288
          }
        },
        "qwen3.5-9b": {
          "modelID": "qwen3.5-9b",
          "name": "Qwen3.5 9B (think, generalist)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true }
          },
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-nt": {
          "modelID": "qwen3.5-9b-nt",
          "name": "Qwen3.5 9B (nothink, generalist)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-mtp": {
          "modelID": "qwen3.5-9b-mtp",
          "name": "Qwen3.5 9B (think, mtp, generalist)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true }
          },
          "limit": {
            "context": 94000,
            "output": 4096
          }
        }
      }
    },
    "opencode": {},
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "modelID": "z-ai/glm-5.3-flash",
          "name": "GLM-5.3-Flash (da game changer)",
          "variants": [
            {
              "id": "explore",
              "body": {
                "temperature": 0.6,
                "top_p": 0.95
              }
            }
          ]
        }
      }
    },
    "opencode-go": {}
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd"
        ]
      }
      // "augure": {
      //   "type": "local",
      //   "command": ["/home/logout/.local/bin/augure-mcp-server"]
      // },
      // "lictor": {
      //   "type": "local",
      //   "command": ["/home/logout/.local/bin/lictor-mcp-server"]
      // },
      // "playwright": {
      //   "type": "local",
      //   "command": ["npx", "-y", "@playwright/mcp@0.0.83", "--headless", "--isolated"]
      // },
      // "rea": {
      //   "type": "local",
      //   "command": ["npx", "-y", "rea-agents@6.7.0", "mcp"]
      // },
      // "socraticode": {
      //   "type": "local",
      //   "command": ["npx", "-y", "socraticode", "mcp"]
      // },
      // "graphicle": {
      //   "type": "local",
      //   "command": ["graphicle", "mcp"]
      // }
    }
  }
}
