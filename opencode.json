{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills",
      "~/.config/opencode/skills/ui-ux-pro-max/.claude/skills",
      "~/.config/opencode/skills/impeccable/.opencode/skills"
    ]
  },
  "plugin": [
    "~/.config/opencode/plugins/caveman/plugin.js",
    "/home/logout/opencode-quota/dist/index.js",
    "opencode-pty",
    "opencode-damage-control"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "pkill*": "deny",
      "kill -9*": "deny",
      "killall*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "rm -rf /": "deny",
      "rm -fr /": "deny",
      "rm -rf ~": "deny",
      "rm -fr ~": "deny",
      "rm -rf ~/": "deny",
      "rm -fr ~/": "deny",
      "rm -rf ..": "deny",
      "mkfs*": "deny",
      "dd if=*of=/dev/*": "deny",
      "dd of=/dev/*": "deny",
      "wipefs*": "deny",
      "chmod -R 777 /": "deny",
      "crontab -r*": "deny",
      "git clean -fdx*": "deny",
      "git clean -fx*": "deny",
      "history -c*": "deny",
      ":(){ :|:& };:": "deny"
    },
    "edit": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "/tmp/opencode": "allow"
    },
    "doom_loop": "ask"
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 6000,
    "reserved": 2000
  },
  "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
  "small_model": "llamacpp-ricinus/qwen3.5-9b-mtp",
  "agent": {
    "build": {
      "model": "openrouter/z-ai/glm-5.3-flash",
      "color": "info"
    },
    "plan": {
      "model": "openrouter/z-ai/glm-5.3-flash",
      "color": "warning"
    },
    "general": {
      "model": "openrouter/z-ai/glm-5.3-flash"
    },
    "explore": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
      "temperature": 0.6,
      "top_p": 0.95,
      "steps": 60
    },
    "title": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
    },
    "summary": {
      "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
    }
  },
  "share": "disabled",
  "autoupdate": "notify",
  "formatter": true,
  "provider": {
    "llamacpp-ricinus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "00 llama.cpp@ricinus-communis",
      "options": {
        "baseURL": "http://192.168.1.26:9931/v1",
        "apiKey": "llamacpp",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        "glm-4.7-flash": {
          "id": "glm-4.7-flash",
          "name": "GLM-4.7-Flash 30B-A3B (think, coder)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 30000,
            "output": 12288
          }
        },
        "qwen3.5-9b": {
          "id": "qwen3.5-9b",
          "name": "Qwen3.5 9B (think, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-nt": {
          "id": "qwen3.5-9b-nt",
          "name": "Qwen3.5 9B (nothink, generalist)",
          "tool_call": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-mtp": {
          "id": "qwen3.5-9b-mtp",
          "name": "Qwen3.5 9B (think, mtp, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        }
      }
    },
    "opencode": {
      "options": {
        "setCacheKey": true
      }
    },
    "openrouter": {
      "options": {
        "setCacheKey": true
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM-5.3-Flash (da game changer)"
        }
      }
    },
    "opencode-go": {}
  },
  "enabled_providers": ["llamacpp-ricinus", "ollama-ricinus", "opencode", "openrouter"],
  "disabled_providers": ["anthropic", "openai"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
