        //   "name": "Qwen3.5 9B",
        //   "tool_call": true,
        //   "reasoning": true,
        //   "limit": { "context": 16384, "output": 4096 }
        // },
        // Disabled: FIM model, unreliable agentic tool calling.
        // "qwen2.5-coder:7B": {
        //   "name": "Qwen2.5-Coder 7B (FIM only)",
        //   "tool_call": false,
        //   "limit": { "context": 16384, "output": 4096 }
        // },
        // Disabled: 47 tg vs 105 for qwen3.5-9b.
        // "lfm2.5:8b-a1b-q4_K_M": {
        //   "name": "LFM2.5 8B-A1B (tool calling)",
        //   "tool_call": true,
