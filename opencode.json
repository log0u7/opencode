{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  "plugin": [
    "~/.config/opencode/plugins/caveman/plugin.js"
  ],
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 6000,
    "reserved": 2000
  },
  "model": "llamacpp-ricinus/qwen3-coder-30b",
  "small_model": "llamacpp-ricinus/qwen3.5-9b-mtp",
  "agent": {
      "build": {
        "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
        "temperature": 0.6,
        "top_p": 0.95,
        "steps": 60,
        "color": "info"
      },
      "plan": {
        "model": "opencode/big-pickle",
        "color": "warning"
      },
      "general": {
        "model": "opencode/big-pickle"
      },
      "explore": {
        "model": "llamacpp-ricinus/qwen3.5-9b-mtp",
        "temperature": 0.6,
        "top_p": 0.95,
        "steps": 60
      }
      "title": {
        "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
      },
      "summary": {
        "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
      },
  "share": "disabled",
  "compaction": {
        "model": "llamacpp-ricinus/qwen3.5-9b-mtp"
      }
  },
  "autoupdate": "notify",
  "formatter": true,
  "provider": {
    "enabled_providers": ["llamacpp-ricinus", "ollama-ricinus", "opencode"],
    "llamacpp-ricinus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "00 llama.cpp@ricinus-communis",
      "options": {
        "baseURL": "http://192.168.1.26:9931/v1",
        "apiKey": "llamacpp",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        // Disabled: superseded by qwen3.5-9b family
        // "qwen3-coder-30b": {
        //   "id": "qwen3-coder-30b-a3b-q4_K_M",
        //   "name": "Qwen3-Coder 30B-A3B (nothink, coder)",
        //   "tool_call": true,
        //   "limit": {
        //     "context": 30000,
        //     "output": 4096
        //   }
        // },
        "glm-4.7-flash": {
          "id": "glm-4.7-flash",
          "name": "GLM-4.7-Flash 30B-A3B (think, coder)",
          "tool_call": true,
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 30000,
            "output": 12288
          }
        },
        "qwen3.5-9b": {
          "id": "qwen3.5-9b",
          "name": "Qwen3.5 9B (think, generalist)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-nt": {
          "id": "qwen3.5-9b-nt",
          "name": "Qwen3.5 9B (nothink, generalist)",
          "tool_call": true,
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-mtp": { 
          "id": "qwen3.5-9b-mtp", 
          "name": "Qwen3.5 9B (think, mtp, generalist)", 
          "tool_call": true, 
          "reasoning": true, 
          "limit": { 
            "context": 94000, 
            "output": 4096 
          } 
        },
        // Disabled in models.ini: verbose, hits context ceiling, cohere2moe
        // arch not in stock llama.cpp. Cohere's own config uses
        // "interleaved": { "field": "reasoning" }.
        // "north-mini-code": {
        //   "id": "north-mini-code-1.0-q4_K_M",
