        //   "tool_call": false,
        //   "limit": { "context": 125000, "output": 4096 }
        // }
      }
    },
    "ollama-ricinus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "01 ollama@ricinus-communis",
      "options": {
        "baseURL": "http://192.168.1.26:11434/v1",
        "apiKey": "ollama",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        // disabled: superseded by qwen3.5-9b family
        // "qwen3.5:4B": {
        //   "name": "Qwen3.5 4B (utility)",
        //   "tool_call": true,
        //   "reasoning": true,
        //   "limit": { "context": 16384, "output": 4096 }
