  "compaction": {
    "auto": true,
    "keep": { "tokens": 6000 },
    "buffer": "10%"
  },
  "model": "openrouter/z-ai/glm-5.3-flash",
  "agents": {
    "build": {
      "model": "openrouter/z-ai/glm-5.3-flash",
      "color": "#56b6c2"
    },
    "plan": {
      "model": "openrouter/z-ai/glm-5.3-flash",
      "color": "#f5a742"
    },
    "general": {
      "model": "openrouter/z-ai/glm-5.3-flash"
    },
    "explore": {
      "model": "openrouter/z-ai/glm-5.3-flash#explore",
      "steps": 60
    },
    "title": {
      "model": "openrouter/z-ai/glm-5.3-flash"
    }
  },
  "share": "disabled",
  "update": "notify",
  "formatter": true,
  "experimental": {
    "background_compaction": false,
    "todo": true
  },
  // "media": { "image": { "auto_resize": true, "max_width": 2000, "max_height": 2000, "max_base64_bytes": 5242880 } },
  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },
  "watcher": { "ignore": ["dist/**", "node_modules/**", "coverage/**", ".cache/**"] },
  "providers": {
    "llamacpp-ricinus": {
      "name": "00 llama.cpp@ricinus-communis",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.1.26:9931/v1",
        "apiKey": "llamacpp",
        "timeout": false,
        "headerTimeout": 300000,
        "chunkTimeout": 180000
      },
      "models": {
        "glm-4.7-flash": {
          "modelID": "glm-4.7-flash",
          "name": "GLM-4.7-Flash 30B-A3B (think, coder)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 30000,
            "output": 12288
          }
        },
        "qwen3.5-9b": {
          "modelID": "qwen3.5-9b",
          "name": "Qwen3.5 9B (think, generalist)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true }
          },
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-nt": {
          "modelID": "qwen3.5-9b-nt",
          "name": "Qwen3.5 9B (nothink, generalist)",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 94000,
            "output": 4096
          }
        },
        "qwen3.5-9b-mtp": {
          "modelID": "qwen3.5-9b-mtp",
          "name": "Qwen3.5 9B (think, mtp, generalist)",
          "capabilities": {
            "tools": true,
            "reasoning": { "supported": true }
          },
          "limit": {
            "context": 94000,
            "output": 4096
          }
        }
      }
    },
    "opencode": {},
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": {
          "modelID": "z-ai/glm-5.3-flash",
          "name": "GLM-5.3-Flash (da game changer)",
          "variants": [
            {
              "id": "explore",
              "body": {
                "temperature": 0.6,
                "top_p": 0.95
              }
            }
          ]
        }
      }
    },
    "opencode-go": {}
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
